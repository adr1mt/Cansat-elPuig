---
import type { Milestone } from "../lib/schemas";
import { upcoming, formatDate, madridToday, daysBetween } from "../lib/domain";
import { path } from "../lib/paths";
import Icon from "./Icon.astro";
interface Props {
  milestones: Milestone[];
}
const { milestones } = Astro.props;
const next = upcoming(milestones)[0];
---

<section class="next-milestone" data-next-milestone>
  <div class="next-copy">
    <h2>
      <Icon name="calendar" /> Proper objectiu
    </h2>
    <h3 data-next-title>{next?.title || "Properes dates pendents"}</h3>
    <p data-next-description>
      {next?.description ||
        "Consulta el calendari per veure els fites amb data pendent o condicionats a classificació."}
    </p>
    <div class="next-date">
      <span class="status" data-next-state>
        {next?.date === madridToday()
          ? "Avui"
          : next
            ? "Proper"
            : "Pendent de data"}
      </span>
      <span data-next-date>
        {next ? formatDate(next.date) : "Sense cap objectiu futur confirmat"}
      </span>
    </div>
    <a class="text-link" href={path("calendari/")}>
      Calendari complet <Icon name="arrow" />
    </a>
  </div>
  <div class="countdown">
    <strong data-next-days>
      {next?.date ? Math.max(0, daysBetween(madridToday(), next.date)) : "—"}
    </strong>
    <span data-next-days-label>dies restants</span>
    <small>Hora local · Europe/Madrid</small>
  </div>
</section>
<script
  type="application/json"
  id="milestone-data"
  set:html={JSON.stringify(milestones).replace(/</g, "\u003c")}
/>
