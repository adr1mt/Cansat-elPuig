---
import type { Team, Task, MissionLog } from "../lib/schemas";
import { states } from "../lib/schemas";
import { activeTasks, progress, latestLogs, formatDate } from "../lib/domain";
import { path } from "../lib/paths";
import Icon from "./Icon.astro";
interface Props {
  team: Team;
  tasks: Task[];
  logs: MissionLog[];
  headingLevel?: 2 | 3;
}
const { team, tasks, logs, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const teamTasks = activeTasks(tasks, team.id, team.yearId);
const stats = progress(teamTasks);
const latest = latestLogs(logs, team.id, team.yearId)[0];
const priority = { active: 0, blocked: 1, pending: 2, done: 3 };
const visibleTasks = [...teamTasks].sort((a, b) => priority[a.status] - priority[b.status]).slice(0, 2);
---

<article class="team-card" style={`--team:${team.color}`}>
  <div class="team-heading">
    <Heading><a href={path(`equips/${team.id}/`)}>{team.name}</a></Heading>
    <span class="team-badge">{team.id.toUpperCase()}</span>
  </div>
  <p class="secondary">{team.secondaryMission || "Missió secundària per definir"}</p>
  <div class="team-progress">
    <div class="progress-label">
      <span><strong>{stats.done} / {stats.total}</strong> tasques completades</span>
      {stats.blocked > 0 && <span>{stats.blocked} bloquejades</span>}
    </div>
    {stats.percent !== null ? (
      <progress value={stats.done} max={stats.total} aria-label={`Progrés de ${team.name}`} />
    ) : <p class="helper">Les tasques es mostraran quan es publiqui la planificació.</p>}
  </div>
  {visibleTasks.length > 0 && (
    <ul class="team-task-preview" aria-label={`Tasques de ${team.name}`}>
      {visibleTasks.map(task => (
        <li>
          <span class:list={["task-check", { complete: task.status === "done" }]} aria-hidden="true"></span>
          <span class="preview-title">{task.title}</span>
          <span class:list={["preview-state", task.status]}>
            <span class:list={["state-dot", task.status]} aria-hidden="true"></span>
            {states[task.status]}
          </span>
        </li>
      ))}
    </ul>
  )}
  <div class="team-bottom">
    <a class="text-link" href={path(`equips/${team.id}/`)} aria-label={`Veure equip ${team.name}`}>Veure equip <Icon name="arrow" /></a>
    {latest && <small>Darrera entrada: {formatDate(latest.date)}</small>}
    {teamTasks.length > visibleTasks.length && <small>{teamTasks.length} tasques en total</small>}
  </div>
</article>
