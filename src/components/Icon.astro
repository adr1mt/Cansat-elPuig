---
interface Props {
  name?: string;
}
const { name = "satellite" } = Astro.props;
const paths: Record<string, string> = {
  satellite:
    "m7 7 4 4m2 2 4 4M4 3 1 7l5 4 3-4zm16 10-3 4 5 4 3-4zM11 9l4 3-3 4-4-3zM15 3a6 6 0 0 1 6 6M15 6a3 3 0 0 1 3 3",
  arrow: "M5 12h14m-6-6 6 6-6 6",
  calendar: "M5 5h14v15H5zM8 2v6m8-6v6M5 10h14",
  appearance: "M12 3a9 9 0 1 0 0 18V3Zm0 0a9 9 0 0 1 0 18",
  activity: "M3 12h4l3-7 4 14 3-7h4",
};
---

<svg
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name] || paths.satellite} />
</svg>
