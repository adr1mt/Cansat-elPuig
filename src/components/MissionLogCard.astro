---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { MissionLog, Team } from "../lib/schemas";
import { formatDate } from "../lib/domain";
import { path } from "../lib/paths";
const photos = import.meta.glob<ImageMetadata>(
  "/public/media/**/*.{jpg,jpeg,png,webp}",
  { eager: true, import: "default" },
);
interface Props {
  log: MissionLog;
  team: Team;
  headingLevel?: 2 | 3;
}
const { log, team, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<article class="log-card" data-filter-item data-team={team.id}>
  <div class="log-meta">
    <a href={path(`equips/${team.id}/`)}>{team.name}</a>
    <time datetime={log.date}>{formatDate(log.date)}</time>
    {log.meeting && <span class="tag">Reunió</span>}
  </div>
  <Heading>{log.title}</Heading>
  <p>{log.summary}</p>
  {log.blockers && (
    <p>
      <strong>Bloquejos:</strong> {log.blockers}
    </p>
  )}
  {log.nextSteps && (
    <p>
      <strong>Propers passos:</strong> {log.nextSteps}
    </p>
  )}
  {log.photo && (
    <figure>
      <Image
        src={photos[`/public${log.photo}`]}
        alt={log.photoAlt}
        width={1200}
        widths={[480, 800, 1200]}
        sizes="(max-width: 767px) 90vw, 560px"
        format="webp"
        loading="lazy"
        decoding="async"
      />
      {log.caption && <figcaption>{log.caption}</figcaption>}
    </figure>
  )}
</article>
