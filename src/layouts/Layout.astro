---
import "../styles/global.css";
import { loadData } from "../lib/data";
import { path } from "../lib/paths";
import Icon from "../components/Icon.astro";
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const { settings, year } = await loadData();
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ["", "Inici"],
  ["equips/", "Equips"],
  ["calendari/", "Calendari"],
  ["diari/", "Diari de missió"],
];
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · {settings.title}</title>
    <meta name="description" content={description || settings.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={path("favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={`${title} · ${settings.title}`} />
    <meta
      property="og:description"
      content={description || settings.description}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ca_ES" />
    <meta name="theme-color" content="#f6f8fa" />
  </head>
  <body>
    <a class="skip" href="#main">
      Salta al contingut
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={path()}>
          <span class="brand-icon">
            <Icon />
          </span>
          <span>
            {settings.title}
            <small>{settings.school}</small>
          </span>
        </a>
        <nav aria-label="Navegació principal">
          {nav.map(([route, label]) => (
            <a
              href={path(route)}
              aria-current={
                Astro.url.pathname === path(route) ? "page" : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
        <span class="course">Curs {year.name}</span>
      </div>
    </header>
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>{settings.title}</strong>
          <p>
            {settings.school} · {settings.location}
          </p>
        </div>
        <div>
          <span>SMX2 · Curs {year.name}</span>
          <a href={settings.officialUrl}>
            Desafiament CanSat · ESERO <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </footer>
    <script>
      import "../scripts/client";
    </script>
  </body>
</html>
