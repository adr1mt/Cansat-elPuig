---
import "../styles/global.css";
import { loadData } from "../lib/data";
import { path } from "../lib/paths";
import Icon from "../components/Icon.astro";
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const { settings, year } = await loadData();
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ["", "Inici"],
  ["equips/", "Equips"],
  ["calendari/", "Calendari"],
  ["diari/", "Diari de missió"],
];
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · {settings.title}</title>
    <meta name="description" content={description || settings.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={path("favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={`${title} · ${settings.title}`} />
    <meta
      property="og:description"
      content={description || settings.description}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ca_ES" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#090f18" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        let preference = "system";
        try { preference = localStorage.getItem("cansat-theme") || "system"; } catch {}
        if (!["light", "dark", "system"].includes(preference)) preference = "system";
        const media = matchMedia("(prefers-color-scheme: dark)");
        const apply = () => {
          const theme = preference === "system" ? (media.matches ? "dark" : "light") : preference;
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.themePreference = preference;
          document.querySelectorAll('meta[name="theme-color"]').forEach(meta => {
            meta.content = theme === "dark" ? "#090f18" : "#f4f6f8";
          });
        };
        apply();
        media.addEventListener("change", apply);
        document.addEventListener("cansat:theme", event => {
          if (!["light", "dark", "system"].includes(event.detail)) return;
          preference = event.detail;
          try { localStorage.setItem("cansat-theme", preference); } catch {}
          apply();
        });
        window.addEventListener("storage", event => {
          if (event.key !== "cansat-theme" && event.key !== null) return;
          preference = ["light", "dark"].includes(event.newValue) ? event.newValue : "system";
          apply();
          const select = document.querySelector("[data-theme-select]");
          if (select) select.value = preference;
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Salta al contingut
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={path()}>
          <span class="brand-icon">
            <Icon />
          </span>
          <span>
            {settings.title}
            <small>{settings.school}</small>
          </span>
        </a>
        <nav aria-label="Navegació principal">
          {nav.map(([route, label]) => (
            <a
              href={path(route)}
              aria-current={
                Astro.url.pathname === path(route) ? "page" : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
        <div class="header-tools">
          <span class="course">Curs {year.name}</span>
          <label class="theme-control" data-enhance hidden>
            <Icon name="appearance" />
            <span class="sr-only">Tema de la web</span>
            <select data-theme-select aria-label="Tema de la web">
              <option value="system">Sistema</option>
              <option value="light">Clar</option>
              <option value="dark">Fosc</option>
            </select>
          </label>
        </div>
      </div>
    </header>
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>{settings.title}</strong>
          <p>
            {settings.school} · {settings.location}
          </p>
        </div>
        <div>
          <span>SMX2 · Curs {year.name}</span>
          <a href={settings.officialUrl}>
            Desafiament CanSat · ESERO <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </footer>
    <script>
      import "../scripts/client";
    </script>
  </body>
</html>
