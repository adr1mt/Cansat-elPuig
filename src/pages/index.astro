---
import Layout from "../layouts/Layout.astro";
import { loadData } from "../lib/data";
import { latestLogs, upcoming } from "../lib/domain";
import { path } from "../lib/paths";
import TeamCard from "../components/TeamCard.astro";
import NextMilestone from "../components/NextMilestone.astro";
import Timeline from "../components/Timeline.astro";
import MissionLogCard from "../components/MissionLogCard.astro";
import EmptyState from "../components/EmptyState.astro";
const d = await loadData();
const latest = d.teams
  .map((t) => latestLogs(d.logs, t.id, d.year.id)[0])
  .filter(Boolean);
---

<Layout title="Inici">
  <div class="mission-strip">
    <span>Centre de missions <span aria-hidden="true">/</span> CanSat</span>
    <span>SMX2 · {d.year.name}</span>
  </div>
  <div class="launch-panel">
  <section class="hero">
    <div class="hero-copy">
      <h1 class="hero-title">{d.settings.heroTitle}</h1>
      <p>{d.settings.description}</p>
      <a class="text-link" href={d.settings.officialUrl}>
        Coneix el desafiament CanSat ↗
      </a>
      <ol class="launch-sequence" aria-label="Etapes d’una missió CanSat">
        <li>Dissenyar</li><li>Construir</li><li>Provar</li><li>Volar</li>
      </ol>
    </div>
    <div class="launch-diagram" aria-hidden="true">
      <svg viewBox="0 0 480 360" fill="none">
        <defs>
          <linearGradient id="earth-light" x1="40" y1="310" x2="440" y2="360" gradientUnits="userSpaceOnUse">
            <stop stop-color="#83bded" stop-opacity=".28" />
            <stop offset="1" stop-color="#83bded" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g stroke="#86add0" stroke-opacity=".25">
          <path d="M24 294H454M24 214H454M24 134H454M24 54H454" stroke-dasharray="2 8" />
          <path d="M35 42v253m-5-1h10m-10-80h10m-10-80h10m-10-80h10" />
          <ellipse cx="257" cy="171" rx="172" ry="116" transform="rotate(-28 257 171)" />
        </g>
        <path d="M10 360Q220 231 480 351v9Z" fill="url(#earth-light)" />
        <path d="M10 360Q220 231 480 351" stroke="#81b9e6" stroke-opacity=".65" />
        <path class="flight-path" d="M119 322C135 192 191 59 319 60C414 61 411 182 352 284" stroke="#ff7855" stroke-width="2" stroke-dasharray="5 7" />
        <circle cx="119" cy="322" r="5" fill="#ff7855" />
        <path d="m344 277 8 8 8-8" stroke="#ff7855" stroke-width="2" />
        <g stroke="#e4f0fa" stroke-width="1.6">
          <path d="M223 126a49 49 0 0 1 98 0Z" fill="#152d45" />
          <path d="M239 126c0-65 65-65 65 0m-32-49v49M223 126l37 61m61-61-37 61m-45-61 25 61m40-61-24 61" />
          <rect x="256" y="187" width="32" height="47" rx="5" fill="#19344e" />
          <path d="M256 199h32m-32 24h32m-16-36v-11m-5 31h10m-10 5h10" />
          <circle cx="272" cy="218" r="2" fill="#ff7855" stroke="none" />
          <path d="M294 203h45l17-17h70M214 100h-41l-19-19H90" stroke="#86add0" stroke-width="1" />
        </g>
        <g fill="#b3cce1" font-family="MissionSans, sans-serif" font-size="10" letter-spacing="1">
          <text x="91" y="73">DESCENS</text>
          <text x="360" y="179">CANSAT</text>
          <text x="41" y="346">ESTACIÓ TERRENA</text>
        </g>
        <g fill="#86add0">
          <circle cx="91" cy="159" r="1.5"/><circle cx="397" cy="40" r="1.5"/>
          <circle cx="199" cy="34" r="1"/><circle cx="429" cy="248" r="1"/>
          <path d="M411 93v8m-4-4h8M160 242v8m-4-4h8" stroke="#86add0" stroke-opacity=".6" />
        </g>
      </svg>
      <span class="diagram-caption">CanSat · Esquema conceptual de vol</span>
    </div>
  </section>
  <NextMilestone milestones={d.milestones} />
  </div>
  <section class="section">
    <div class="section-heading">
      <h2>Les nostres missions</h2>
      <a href={path("equips/")} class="text-link">
        Tots els equips →
      </a>
    </div>
    <div class="team-grid">
      {d.teams.map((team) => (
        <TeamCard team={team} tasks={d.tasks} logs={d.logs} />
      ))}
    </div>
  </section>
  <div class="home-bottom">
    <section>
      <div class="section-heading">
        <h2>Última activitat</h2>
        <a class="text-link" href={path("diari/")}>
          Obrir el diari →
        </a>
      </div>
      {latest.length ? (
        latestLogs(latest).map((log) => (
          <MissionLogCard
            log={log}
            team={d.teams.find((t) => t.id === log.teamId)!}
          />
        ))
      ) : (
        <EmptyState
          title="La missió tot just comença"
          text="Encara no hi ha avenços publicats. Aquí trobaràs els resums de les reunions i les proves de cada equip."
        />
      )}
    </section>
    <section>
      <div class="section-heading">
        <h2>Properes fites</h2>
        <a class="text-link" href={path("calendari/")}>
          Veure calendari →
        </a>
      </div>
      <div data-upcoming-list>
        <Timeline compact milestones={upcoming(d.milestones).slice(0, 3)} />
      </div>
      <p class="helper">
        Les dates pendents i les fases condicionades es poden consultar al
        calendari.
      </p>
    </section>
  </div>
</Layout>
