---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import cansatSchematic from "../assets/cansat-schematic.png";
import { loadData } from "../lib/data";
import { latestLogs, upcoming } from "../lib/domain";
import { path } from "../lib/paths";
import TeamCard from "../components/TeamCard.astro";
import NextMilestone from "../components/NextMilestone.astro";
import Timeline from "../components/Timeline.astro";
import MissionLogCard from "../components/MissionLogCard.astro";
import EmptyState from "../components/EmptyState.astro";
const d = await loadData();
const latest = d.teams
  .map((t) => latestLogs(d.logs, t.id, d.year.id)[0])
  .filter(Boolean);
---

<Layout title="Inici">
  <div class="mission-strip">
    <span>Seguiment <span aria-hidden="true">/</span> CanSat</span>
    <span>SMX2 · {d.year.name}</span>
  </div>
  <div class="launch-panel">
  <section class="hero">
    <div class="hero-copy">
      <h1 class="hero-title">{d.settings.heroTitle}</h1>
      <p>{d.settings.description}</p>
      <a class="text-link" href={d.settings.officialUrl}>
        Web oficial CanSat ↗
      </a>
      <ol class="launch-sequence" aria-label="Etapes d’una missió CanSat">
        <li>Dissenyar</li><li>Construir</li><li>Provar</li><li>Volar</li>
      </ol>
    </div>
    <div class="launch-diagram">
      <Image
        src={cansatSchematic}
        alt="Esquema conceptual d’un CanSat amb paracaigudes, ràdio i sensors, i la trajectòria de descens."
        width={480}
        height={360}
        widths={[480, 960]}
        sizes="(max-width: 767px) 330px, (max-width: 1100px) 40vw, 460px"
        format="webp"
        loading="eager"
      />
      <span class="diagram-caption">CanSat · Esquema conceptual de vol</span>
    </div>
  </section>
  <NextMilestone milestones={d.milestones} />
  </div>
  <section class="section">
    <div class="section-heading">
      <h2>Equips</h2>
      <a href={path("equips/")} class="text-link">
        Tots els equips →
      </a>
    </div>
    <div class="team-grid">
      {d.teams.map((team) => (
        <TeamCard team={team} tasks={d.tasks} logs={d.logs} />
      ))}
    </div>
  </section>
  <div class="home-bottom">
    <section>
      <div class="section-heading">
        <h2>Última activitat</h2>
        <a class="text-link" href={path("diari/")}>
          Obrir el diari →
        </a>
      </div>
      {latest.length ? (
        latestLogs(latest).map((log) => (
          <MissionLogCard
            log={log}
            team={d.teams.find((t) => t.id === log.teamId)!}
          />
        ))
      ) : (
        <EmptyState
          title="Sense entrades publicades"
          text="Les reunions i les proves es publicaran al diari."
        />
      )}
    </section>
    <section>
      <div class="section-heading">
        <h2>Properes fites</h2>
        <a class="text-link" href={path("calendari/")}>
          Veure calendari →
        </a>
      </div>
      <div data-upcoming-list>
        <Timeline compact milestones={upcoming(d.milestones).slice(0, 3)} />
      </div>
      <p class="helper">
        Les dates pendents i les fases condicionades es poden consultar al
        calendari.
      </p>
    </section>
  </div>
</Layout>
